# ExpenseGuard 环境变量模板
#
# 用法：cp .env.example .env，然后填入真实值。
# .env 永不进仓库（.gitignore 已排除）。本文件只含键名，不含任何真实值。

# ============================================================
# 应用
# ============================================================
APP_ENV=
LOG_LEVEL=
API_HOST=
API_PORT=

# ============================================================
# PostgreSQL —— 业务表 + 审计日志 + LangGraph checkpoint 同库不同 schema
# ============================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# 形如 postgresql+psycopg://<user>:<password>@127.0.0.1:5432/expenseguard
DATABASE_URL=

# ============================================================
# 会话与安全
# 注意：session 存 PostgreSQL 表，不引入 Redis。
# SESSION_COOKIE_SECURE 在 prod 必须为 true。
# ============================================================
# cookie 名**刻意不是配置项**：FastAPI 的 Cookie(alias=...) 在导入时求值，
# 拿不到运行时配置，做成配置项会导致「写用配置名、读用硬编码名」的错位。
# 名字固定在 core/security/session_service.py 的 SESSION_COOKIE_NAME。
# 且 Settings 是 extra="forbid"，在 .env 里写 SESSION_COOKIE_NAME 会启动即报错。
SESSION_COOKIE_SECURE=
SESSION_IDLE_TIMEOUT_SECONDS=
SESSION_ABSOLUTE_TIMEOUT_SECONDS=
SESSION_TOUCH_THROTTLE_SECONDS=

# 带 cookie 的跨域请求不允许通配符，必须显式列出源（逗号分隔）
CORS_ALLOWED_ORIGINS=

# ============================================================
# 多租户
# MVP 单租户运行，但所有业务表带 tenant_id
# ============================================================
DEFAULT_TENANT_SLUG=

# ============================================================
# Qdrant —— 制度条款向量
# ============================================================
QDRANT_URL=
QDRANT_COLLECTION=

# ============================================================
# Embedding / Rerank —— 本地自托管
# 硬承诺：检索层数据不出内网
# 这两个服务定义在 docker-compose.models.yml，不随默认 up 启动
# ============================================================
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_DIM=
RERANK_BASE_URL=
RERANK_MODEL=

# ============================================================
# LLM —— OpenAI 兼容抽象（云 API ⇄ vLLM，切换成本＝改这几项）
# 注意：PII 进入 LLM 前必须脱敏
# ============================================================
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============================================================
# 可观测 —— Langfuse + OpenTelemetry
# Phase 1 默认 TRACING_ENABLED=false：此阶段无 LLM 调用，
# 关闭时后端启动不得产生任何网络调用
# ============================================================
TRACING_ENABLED=
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 自托管 Langfuse 容器自身的密钥（docker-compose.observability.yml 要求，
# 没有默认值——有默认值的密钥等于没有密钥）。生成：openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_DISABLE_SIGNUP=

# ============================================================
# 前端（Vite 只暴露 VITE_ 前缀的变量给浏览器 —— 严禁放任何密钥）
# ============================================================
VITE_API_BASE_URL=

# ============================================================
# Docker Compose
# ============================================================
COMPOSE_PROJECT_NAME=
