# ============================================================
# 客户数据与租户配置 —— 脱敏硬约束
# 脱敏 = 删除这两个目录。它们从第一次 commit 起就被排除，
# 事后再加无法清除 git 历史。不要为它们添加任何 ! 例外规则：
# 被排除的目录内部不再被 git 遍历，! 不会生效。
# 目录结构的可复现性靠 backend/app/core/config/defaults/*.json
# 与 scripts/bootstrap_tenant.py（两者都跟踪进仓库）。
# ============================================================
tenants/
data/private/

# ============================================================
# 密钥 —— 真实凭据永不提交；模板文件保持跟踪
# ============================================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.p12
*.pfx
secrets/

# 本机专属的 Claude Code 配置
.claude/settings.local.json

# ============================================================
# Python
# 注意：uv.lock 必须提交，不要加入本表
# ============================================================
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml
.ipynb_checkpoints/

# ============================================================
# Node / 前端
# 注意：package-lock.json 与 openapi.json 必须提交
# ============================================================
node_modules/
dist/
build/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo
.eslintcache

# ============================================================
# 评测与可观测工具的本地缓存
# ============================================================
.deepeval/
.deepeval-cache.json
temp_test_run_data.json
.promptfoo/

# ============================================================
# 本地卷、缓存、模型权重
# ============================================================
.docker-data/
.cache/
models/

# ============================================================
# 真实报销文件误放根目录的兜底
# 只用 /*.xlsx 限定根目录 —— 全局 *.xlsx 会挡掉 data/synthetic/ 的测试夹具
# ============================================================
/*.xlsx
/*.xls
/*.csv

# ============================================================
# 日志、编辑器、系统垃圾
# ============================================================
*.log
logs/
.idea/
.vscode/
.DS_Store
Thumbs.db
