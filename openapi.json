{
  "components": {
    "schemas": {
      "BatchDetailResponse": {
        "description": "批次详情响应。",
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "file_version_id": {
            "format": "uuid",
            "title": "File Version Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ExpenseRowResponse"
            },
            "title": "Rows",
            "type": "array"
          },
          "uploaded_at": {
            "format": "date-time",
            "title": "Uploaded At",
            "type": "string"
          },
          "uploaded_by": {
            "format": "uuid",
            "title": "Uploaded By",
            "type": "string"
          }
        },
        "required": [
          "file_version_id",
          "filename",
          "content_hash",
          "row_count",
          "uploaded_at",
          "uploaded_by",
          "rows"
        ],
        "title": "BatchDetailResponse",
        "type": "object"
      },
      "BatchImportResponse": {
        "description": "批次导入响应。",
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "file_version_id": {
            "format": "uuid",
            "title": "File Version Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "reused_existing": {
            "title": "Reused Existing",
            "type": "boolean"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "stored_rows": {
            "title": "Stored Rows",
            "type": "integer"
          },
          "uploaded_at": {
            "format": "date-time",
            "title": "Uploaded At",
            "type": "string"
          },
          "uploaded_by": {
            "format": "uuid",
            "title": "Uploaded By",
            "type": "string"
          }
        },
        "required": [
          "file_version_id",
          "filename",
          "content_hash",
          "row_count",
          "uploaded_at",
          "uploaded_by",
          "reused_existing",
          "stored_rows"
        ],
        "title": "BatchImportResponse",
        "type": "object"
      },
      "BatchSummaryResponse": {
        "description": "批次列表项。",
        "properties": {
          "content_hash": {
            "title": "Content Hash",
            "type": "string"
          },
          "file_version_id": {
            "format": "uuid",
            "title": "File Version Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "uploaded_at": {
            "format": "date-time",
            "title": "Uploaded At",
            "type": "string"
          },
          "uploaded_by": {
            "format": "uuid",
            "title": "Uploaded By",
            "type": "string"
          }
        },
        "required": [
          "file_version_id",
          "filename",
          "content_hash",
          "row_count",
          "uploaded_at",
          "uploaded_by"
        ],
        "title": "BatchSummaryResponse",
        "type": "object"
      },
      "Body_batches_import": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_batches_import",
        "type": "object"
      },
      "CurrentUser": {
        "description": "当前登录用户。",
        "properties": {
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "tenant_id",
          "role",
          "permissions"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "DependencyHealth": {
        "description": "单个依赖的健康状况。",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DependencyStatus"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "DependencyHealth",
        "type": "object"
      },
      "DependencyStatus": {
        "description": "依赖状态。",
        "enum": [
          "up",
          "down"
        ],
        "title": "DependencyStatus",
        "type": "string"
      },
      "ExpenseRowResponse": {
        "description": "原始报销行摘要。",
        "properties": {
          "parse_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parse Error"
          },
          "raw_json": {
            "additionalProperties": true,
            "title": "Raw Json",
            "type": "object"
          },
          "row_no": {
            "title": "Row No",
            "type": "integer"
          }
        },
        "required": [
          "row_no",
          "raw_json",
          "parse_error"
        ],
        "title": "ExpenseRowResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "存活响应。",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "登录请求。",
        "properties": {
          "password": {
            "maxLength": 256,
            "title": "Password",
            "type": "string"
          },
          "tenant_slug": {
            "default": "default",
            "maxLength": 64,
            "title": "Tenant Slug",
            "type": "string"
          },
          "username": {
            "maxLength": 128,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "就绪响应。",
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyHealth"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "dependencies"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "Role": {
        "description": "RBAC 三角色。权限矩阵定义在 `app.core.security.permissions`。",
        "enum": [
          "auditor",
          "configurator",
          "viewer"
        ],
        "title": "Role",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "面向内部财务团队的费用报销预审系统",
    "title": "ExpenseGuard API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "登录并下发会话 cookie。",
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "登出。\n\n只撤销**本次请求所用的那一个**会话（`auth.session_id` 由认证依赖\n精确解析得出），因此同一用户在其它设备上的登录不受影响。\n\n服务端标记 `revoked_at`（UPDATE 而非 DELETE —— 留痕），\n同时清掉浏览器 cookie。",
        "operationId": "auth_logout",
        "parameters": [
          {
            "in": "cookie",
            "name": "eg_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eg Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "返回当前登录用户。前端用它做路由守卫。",
        "operationId": "auth_me",
        "parameters": [
          {
            "in": "cookie",
            "name": "eg_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eg Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/batches": {
      "get": {
        "description": "列出当前租户批次。",
        "operationId": "batches_list",
        "parameters": [
          {
            "in": "cookie",
            "name": "eg_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eg Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BatchSummaryResponse"
                  },
                  "title": "Response Batches List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List",
        "tags": [
          "batches"
        ]
      },
      "post": {
        "description": "上传 Excel 并创建或复用文件版本。",
        "operationId": "batches_import",
        "parameters": [
          {
            "in": "cookie",
            "name": "eg_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eg Session"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_batches_import"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import",
        "tags": [
          "batches"
        ]
      }
    },
    "/api/batches/{file_version_id}": {
      "get": {
        "description": "读取批次详情。",
        "operationId": "batches_detail",
        "parameters": [
          {
            "in": "path",
            "name": "file_version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "File Version Id",
              "type": "string"
            }
          },
          {
            "in": "cookie",
            "name": "eg_session",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eg Session"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Detail",
        "tags": [
          "batches"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "存活探针。刻意不碰任何外部依赖。",
        "operationId": "health_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "description": "就绪探针。并发探测各依赖，任一不可用即整体未就绪。",
        "operationId": "health_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    }
  }
}
